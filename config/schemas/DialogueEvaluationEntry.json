{
  "additionalProperties": false,
  "description": "Immutable link between current audio, actual speech and semantic expectation.",
  "properties": {
    "audio_file": {
      "title": "Audio File",
      "type": "string"
    },
    "audio_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Audio Sha256",
      "type": "string"
    },
    "condition": {
      "enum": [
        "quiet-near",
        "normal-room",
        "controlled-noise"
      ],
      "title": "Condition",
      "type": "string"
    },
    "critical_markers": {
      "default": [],
      "items": {
        "enum": [
          "affirmation",
          "cancellation",
          "correction",
          "negation"
        ],
        "type": "string"
      },
      "title": "Critical Markers",
      "type": "array"
    },
    "expected_dialogue_act": {
      "enum": [
        "command",
        "query",
        "correction",
        "cancel",
        "confirm"
      ],
      "title": "Expected Dialogue Act",
      "type": "string"
    },
    "expected_intent": {
      "minLength": 1,
      "title": "Expected Intent",
      "type": "string"
    },
    "expected_policy": {
      "enum": [
        "none",
        "allow",
        "confirm",
        "deny"
      ],
      "title": "Expected Policy",
      "type": "string"
    },
    "expected_referents": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Expected Referents",
      "type": "array"
    },
    "expected_slots": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Expected Slots",
      "type": "object"
    },
    "requires_context": {
      "title": "Requires Context",
      "type": "boolean"
    },
    "scenario_id": {
      "pattern": "^dlg_[0-9]{3}$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_session": {
      "minLength": 1,
      "title": "Source Session",
      "type": "string"
    },
    "split": {
      "enum": [
        "development",
        "held-out"
      ],
      "title": "Split",
      "type": "string"
    },
    "spoken_reference": {
      "minLength": 1,
      "title": "Spoken Reference",
      "type": "string"
    },
    "turn_id": {
      "pattern": "^dlg_[0-9]{3}_t[0-9]{2}$",
      "title": "Turn Id",
      "type": "string"
    },
    "utterance_id": {
      "pattern": "^tg_[0-9]{3}$",
      "title": "Utterance Id",
      "type": "string"
    }
  },
  "required": [
    "utterance_id",
    "scenario_id",
    "turn_id",
    "condition",
    "split",
    "audio_file",
    "audio_sha256",
    "spoken_reference",
    "expected_dialogue_act",
    "expected_intent",
    "expected_policy",
    "requires_context",
    "source_session"
  ],
  "title": "DialogueEvaluationEntry",
  "type": "object"
}
