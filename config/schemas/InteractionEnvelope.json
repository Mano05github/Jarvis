{
  "$defs": {
    "Assumption": {
      "additionalProperties": false,
      "properties": {
        "evidence_reference_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Evidence Reference Ids",
          "type": "array"
        },
        "field": {
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "field",
        "value",
        "evidence_reference_ids"
      ],
      "title": "Assumption",
      "type": "object"
    },
    "ClarificationRequest": {
      "additionalProperties": false,
      "properties": {
        "candidate_reference_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Candidate Reference Ids",
          "type": "array"
        },
        "field": {
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "field",
        "reason",
        "question"
      ],
      "title": "ClarificationRequest",
      "type": "object"
    },
    "DataClass": {
      "enum": [
        "PUBLIC",
        "PERSONAL",
        "CONFIDENTIAL",
        "SECRET",
        "PROHIBITED"
      ],
      "title": "DataClass",
      "type": "string"
    },
    "InteractionMode": {
      "enum": [
        "chat",
        "answer",
        "clarify",
        "plan",
        "mixed",
        "confirm",
        "cancel",
        "no_action"
      ],
      "title": "InteractionMode",
      "type": "string"
    },
    "MemoryProposal": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "minLength": 1,
          "title": "Category",
          "type": "string"
        },
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "data_class": {
          "$ref": "#/$defs/DataClass",
          "default": "PERSONAL"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "category",
        "content",
        "reason"
      ],
      "title": "MemoryProposal",
      "type": "object"
    },
    "PlanProposal": {
      "additionalProperties": false,
      "properties": {
        "goal": {
          "minLength": 1,
          "title": "Goal",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/PlanStepProposal"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "goal",
        "steps"
      ],
      "title": "PlanProposal",
      "type": "object"
    },
    "PlanStepProposal": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "arguments": {
          "additionalProperties": true,
          "title": "Arguments",
          "type": "object"
        },
        "depends_on": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Depends On",
          "type": "array"
        },
        "evidence_reference_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Evidence Reference Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "step_id": {
          "minLength": 1,
          "title": "Step Id",
          "type": "string"
        }
      },
      "required": [
        "step_id",
        "action"
      ],
      "title": "PlanStepProposal",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assumptions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Assumption"
      },
      "maxItems": 16,
      "title": "Assumptions",
      "type": "array"
    },
    "authority": {
      "const": "none",
      "default": "none",
      "title": "Authority",
      "type": "string"
    },
    "clarification": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClarificationRequest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evidence_reference_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "title": "Evidence Reference Ids",
      "type": "array"
    },
    "memory_proposals": {
      "default": [],
      "items": {
        "$ref": "#/$defs/MemoryProposal"
      },
      "maxItems": 8,
      "title": "Memory Proposals",
      "type": "array"
    },
    "mode": {
      "$ref": "#/$defs/InteractionMode"
    },
    "plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlanProposal"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reply": {
      "default": "",
      "title": "Reply",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "understood_goal": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Understood Goal"
    }
  },
  "required": [
    "request_id",
    "mode"
  ],
  "title": "InteractionEnvelope",
  "type": "object"
}
