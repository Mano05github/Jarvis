{
  "$defs": {
    "ProviderKind": {
      "enum": [
        "fake",
        "azure_openai",
        "openai",
        "anthropic",
        "openai_compatible",
        "ollama",
        "llama_cpp"
      ],
      "title": "ProviderKind",
      "type": "string"
    },
    "ProviderState": {
      "enum": [
        "healthy",
        "degraded",
        "unavailable"
      ],
      "title": "ProviderState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "checked_at": {
      "format": "date-time",
      "title": "Checked At",
      "type": "string"
    },
    "detail": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Detail"
    },
    "latency_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latency Ms"
    },
    "profile_id": {
      "minLength": 1,
      "title": "Profile Id",
      "type": "string"
    },
    "provider": {
      "$ref": "#/$defs/ProviderKind"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/ProviderState"
    }
  },
  "required": [
    "profile_id",
    "provider",
    "state"
  ],
  "title": "ProviderHealth",
  "type": "object"
}
