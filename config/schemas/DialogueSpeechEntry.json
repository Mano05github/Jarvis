{
  "additionalProperties": false,
  "description": "Owner-speech prompt derived from a dialogue turn without embedding movie text.",
  "properties": {
    "alternate_references": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Alternate References",
      "type": "array"
    },
    "audio_file": {
      "minLength": 1,
      "title": "Audio File",
      "type": "string"
    },
    "condition": {
      "enum": [
        "quiet-near",
        "normal-room",
        "controlled-noise"
      ],
      "title": "Condition",
      "type": "string"
    },
    "consented": {
      "const": true,
      "title": "Consented",
      "type": "boolean"
    },
    "elicitation": {
      "minLength": 1,
      "title": "Elicitation",
      "type": "string"
    },
    "intent_label": {
      "minLength": 1,
      "title": "Intent Label",
      "type": "string"
    },
    "language": {
      "const": "mixed",
      "default": "mixed",
      "title": "Language",
      "type": "string"
    },
    "prompt_mode": {
      "default": "elicited",
      "enum": [
        "elicited",
        "exact"
      ],
      "title": "Prompt Mode",
      "type": "string"
    },
    "reference": {
      "minLength": 1,
      "title": "Reference",
      "type": "string"
    },
    "retain_until": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retain Until"
    },
    "scenario_id": {
      "pattern": "^dlg_[0-9]{3}$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "split": {
      "enum": [
        "development",
        "held-out"
      ],
      "title": "Split",
      "type": "string"
    },
    "spoken_reference": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Spoken Reference"
    },
    "turn_id": {
      "pattern": "^dlg_[0-9]{3}_t[0-9]{2}$",
      "title": "Turn Id",
      "type": "string"
    },
    "utterance_id": {
      "pattern": "^tg_[0-9]{3}$",
      "title": "Utterance Id",
      "type": "string"
    }
  },
  "required": [
    "utterance_id",
    "reference",
    "elicitation",
    "intent_label",
    "scenario_id",
    "turn_id",
    "condition",
    "split",
    "audio_file",
    "consented"
  ],
  "title": "DialogueSpeechEntry",
  "type": "object"
}
