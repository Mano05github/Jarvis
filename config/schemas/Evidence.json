{
  "$defs": {
    "Outcome": {
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "UNCERTAIN",
        "CANCELLED"
      ],
      "title": "Outcome",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "digest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Digest"
    },
    "evidence_id": {
      "format": "uuid",
      "title": "Evidence Id",
      "type": "string"
    },
    "intent_id": {
      "format": "uuid",
      "title": "Intent Id",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/Outcome"
    },
    "predicate": {
      "minLength": 1,
      "title": "Predicate",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "minLength": 1,
      "title": "Source",
      "type": "string"
    }
  },
  "required": [
    "intent_id",
    "predicate",
    "outcome",
    "source"
  ],
  "title": "Evidence",
  "type": "object"
}
