{
  "additionalProperties": false,
  "description": "One original owner/assistant turn with its semantic evaluation target.",
  "properties": {
    "alternate_surfaces": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Alternate Surfaces",
      "type": "array"
    },
    "dialogue_act": {
      "enum": [
        "command",
        "query",
        "correction",
        "cancel",
        "confirm",
        "clarify",
        "acknowledge",
        "completion",
        "status",
        "warning"
      ],
      "title": "Dialogue Act",
      "type": "string"
    },
    "elicitation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Elicitation"
    },
    "expected_policy": {
      "default": "none",
      "enum": [
        "none",
        "allow",
        "confirm",
        "deny"
      ],
      "title": "Expected Policy",
      "type": "string"
    },
    "intent_label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Intent Label"
    },
    "refers_to": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Refers To",
      "type": "array"
    },
    "requires_context": {
      "default": false,
      "title": "Requires Context",
      "type": "boolean"
    },
    "slots": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Slots",
      "type": "object"
    },
    "speaker": {
      "enum": [
        "owner",
        "assistant"
      ],
      "title": "Speaker",
      "type": "string"
    },
    "state_updates": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "State Updates",
      "type": "object"
    },
    "surface_text": {
      "minLength": 1,
      "title": "Surface Text",
      "type": "string"
    },
    "turn_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$",
      "title": "Turn Id",
      "type": "string"
    }
  },
  "required": [
    "turn_id",
    "speaker",
    "dialogue_act",
    "surface_text"
  ],
  "title": "DialogueTurn",
  "type": "object"
}
