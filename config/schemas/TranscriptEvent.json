{
  "$defs": {
    "LanguageSpan": {
      "additionalProperties": false,
      "properties": {
        "end_char": {
          "minimum": 0,
          "title": "End Char",
          "type": "integer"
        },
        "language": {
          "enum": [
            "ta",
            "en",
            "other",
            "unknown"
          ],
          "title": "Language",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "start_char": {
          "minimum": 0,
          "title": "Start Char",
          "type": "integer"
        }
      },
      "required": [
        "language",
        "start_char",
        "end_char"
      ],
      "title": "LanguageSpan",
      "type": "object"
    },
    "PrivacyMode": {
      "enum": [
        "WATCHING",
        "PRIVATE",
        "SLEEPING"
      ],
      "title": "PrivacyMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "confidence": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence"
    },
    "emitted_monotonic_ns": {
      "minimum": 0,
      "title": "Emitted Monotonic Ns",
      "type": "integer"
    },
    "language_spans": {
      "default": [],
      "items": {
        "$ref": "#/$defs/LanguageSpan"
      },
      "title": "Language Spans",
      "type": "array"
    },
    "privacy_mode": {
      "$ref": "#/$defs/PrivacyMode"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "format": "uuid",
      "title": "Session Id",
      "type": "string"
    },
    "state": {
      "enum": [
        "partial",
        "final"
      ],
      "title": "State",
      "type": "string"
    },
    "text": {
      "title": "Text",
      "type": "string"
    },
    "truncated": {
      "default": false,
      "title": "Truncated",
      "type": "boolean"
    },
    "utterance_id": {
      "format": "uuid",
      "title": "Utterance Id",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "utterance_id",
    "emitted_monotonic_ns",
    "state",
    "text",
    "privacy_mode"
  ],
  "title": "TranscriptEvent",
  "type": "object"
}
