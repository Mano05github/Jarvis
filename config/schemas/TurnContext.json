{
  "$defs": {
    "ContextReference": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": true,
          "title": "Attributes",
          "type": "object"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "reference_id": {
          "minLength": 1,
          "title": "Reference Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "reference_id",
        "kind",
        "label"
      ],
      "title": "ContextReference",
      "type": "object"
    },
    "ConversationTurn": {
      "additionalProperties": false,
      "properties": {
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "role": {
          "enum": [
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "role",
        "text"
      ],
      "title": "ConversationTurn",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "input_text": {
      "minLength": 1,
      "title": "Input Text",
      "type": "string"
    },
    "pending_dialogue_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pending Dialogue Id"
    },
    "permitted_memories": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 16,
      "title": "Permitted Memories",
      "type": "array"
    },
    "recent_turns": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ConversationTurn"
      },
      "maxItems": 24,
      "title": "Recent Turns",
      "type": "array"
    },
    "references": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ContextReference"
      },
      "maxItems": 32,
      "title": "References",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "format": "uuid",
      "title": "Session Id",
      "type": "string"
    },
    "transcript_evidence_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Transcript Evidence Id"
    },
    "turn_id": {
      "format": "uuid",
      "title": "Turn Id",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "input_text"
  ],
  "title": "TurnContext",
  "type": "object"
}
