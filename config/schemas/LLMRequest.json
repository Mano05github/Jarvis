{
  "$defs": {
    "DataClass": {
      "enum": [
        "PUBLIC",
        "PERSONAL",
        "CONFIDENTIAL",
        "SECRET",
        "PROHIBITED"
      ],
      "title": "DataClass",
      "type": "string"
    },
    "LLMMessage": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "role": {
          "enum": [
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "LLMMessage",
      "type": "object"
    },
    "LLMPrivacyClass": {
      "enum": [
        "local_only",
        "remote_redacted",
        "remote_allowed"
      ],
      "title": "LLMPrivacyClass",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "context": {
      "additionalProperties": true,
      "title": "Context",
      "type": "object"
    },
    "data_classes": {
      "items": {
        "$ref": "#/$defs/DataClass"
      },
      "title": "Data Classes",
      "type": "array",
      "uniqueItems": true
    },
    "deadline_ms": {
      "default": 30000,
      "maximum": 300000,
      "minimum": 100,
      "title": "Deadline Ms",
      "type": "integer"
    },
    "maximum_output_tokens": {
      "default": 800,
      "maximum": 8192,
      "minimum": 1,
      "title": "Maximum Output Tokens",
      "type": "integer"
    },
    "messages": {
      "items": {
        "$ref": "#/$defs/LLMMessage"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Messages",
      "type": "array"
    },
    "privacy_class": {
      "$ref": "#/$defs/LLMPrivacyClass"
    },
    "purpose": {
      "minLength": 1,
      "title": "Purpose",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "response_schema": {
      "minLength": 1,
      "title": "Response Schema",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "system_instructions": {
      "minLength": 1,
      "title": "System Instructions",
      "type": "string"
    },
    "temperature": {
      "default": 0.2,
      "maximum": 2,
      "minimum": 0,
      "title": "Temperature",
      "type": "number"
    }
  },
  "required": [
    "purpose",
    "system_instructions",
    "messages",
    "response_schema",
    "privacy_class"
  ],
  "title": "LLMRequest",
  "type": "object"
}
