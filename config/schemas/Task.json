{
  "$defs": {
    "DataClass": {
      "enum": [
        "PUBLIC",
        "PERSONAL",
        "CONFIDENTIAL",
        "SECRET",
        "PROHIBITED"
      ],
      "title": "DataClass",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "data_classes": {
      "items": {
        "$ref": "#/$defs/DataClass"
      },
      "title": "Data Classes",
      "type": "array",
      "uniqueItems": true
    },
    "goal": {
      "minLength": 1,
      "title": "Goal",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "format": "uuid",
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "goal"
  ],
  "title": "Task",
  "type": "object"
}
