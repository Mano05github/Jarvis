{
  "$defs": {
    "ProviderKind": {
      "enum": [
        "fake",
        "azure_openai",
        "openai",
        "anthropic",
        "openai_compatible",
        "ollama",
        "llama_cpp"
      ],
      "title": "ProviderKind",
      "type": "string"
    },
    "ProviderProfile": {
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Version"
        },
        "credential_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credential Ref"
        },
        "deployment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deployment"
        },
        "endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endpoint"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "model_manifest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Manifest"
        },
        "profile_id": {
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/ProviderKind"
        },
        "remote": {
          "title": "Remote",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 30.0,
          "exclusiveMinimum": 0,
          "maximum": 300,
          "title": "Timeout Seconds",
          "type": "number"
        }
      },
      "required": [
        "profile_id",
        "provider",
        "remote"
      ],
      "title": "ProviderProfile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "default_profile": {
      "minLength": 1,
      "title": "Default Profile",
      "type": "string"
    },
    "fallback_order": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Fallback Order",
      "type": "array"
    },
    "profiles": {
      "additionalProperties": {
        "$ref": "#/$defs/ProviderProfile"
      },
      "minProperties": 1,
      "title": "Profiles",
      "type": "object"
    },
    "routing": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Routing",
      "type": "object"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "default_profile",
    "profiles"
  ],
  "title": "GatewayConfig",
  "type": "object"
}
