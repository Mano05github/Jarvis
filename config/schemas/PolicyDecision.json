    "Decision": {
      "enum": [
        "ALLOW",
        "DENY",
        "ASK"
      ],
      "title": "Decision",
      "type": "string"
    },
    "RiskLevel": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
