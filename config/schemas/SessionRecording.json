        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Audio Sha256"
    },
    "channels": {
      "title": "Channels",
      "type": "integer"
    },
    "duration_seconds": {
      "exclusiveMinimum": 0,
      "title": "Duration Seconds",
      "type": "number"
    },
    "frames": {
      "exclusiveMinimum": 0,
      "title": "Frames",
      "type": "integer"
    },
    "path": {
