    },
    "rms_dbfs": {
      "title": "Rms Dbfs",
      "type": "number"
    },
    "sample_rate_hz": {
      "title": "Sample Rate Hz",
      "type": "integer"
    },
    "sample_width_bytes": {
      "title": "Sample Width Bytes",
      "type": "integer"
    },
    "scenario_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
