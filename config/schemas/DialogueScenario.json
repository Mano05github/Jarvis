{
  "$defs": {
    "DialogueTurn": {
      "additionalProperties": false,
      "description": "One original owner/assistant turn with its semantic evaluation target.",
      "properties": {
        "alternate_surfaces": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Alternate Surfaces",
          "type": "array"
        },
        "dialogue_act": {
          "enum": [
            "command",
            "query",
            "correction",
            "cancel",
            "confirm",
            "clarify",
            "acknowledge",
            "completion",
            "status",
            "warning"
          ],
          "title": "Dialogue Act",
          "type": "string"
        },
        "elicitation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elicitation"
        },
        "expected_policy": {
          "default": "none",
          "enum": [
            "none",
            "allow",
            "confirm",
            "deny"
          ],
          "title": "Expected Policy",
          "type": "string"
        },
        "intent_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Intent Label"
        },
        "refers_to": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Refers To",
          "type": "array"
        },
        "requires_context": {
          "default": false,
          "title": "Requires Context",
          "type": "boolean"
        },
        "slots": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Slots",
          "type": "object"
        },
        "speaker": {
          "enum": [
            "owner",
            "assistant"
          ],
          "title": "Speaker",
          "type": "string"
        },
        "state_updates": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "State Updates",
          "type": "object"
        },
        "surface_text": {
          "minLength": 1,
          "title": "Surface Text",
          "type": "string"
        },
        "turn_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$",
          "title": "Turn Id",
          "type": "string"
        }
      },
      "required": [
        "turn_id",
        "speaker",
        "dialogue_act",
        "surface_text"
      ],
      "title": "DialogueTurn",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "An original multi-turn test scenario inspired only by interaction patterns.",
  "properties": {
    "initial_state": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Initial State",
      "type": "object"
    },
    "mode": {
      "enum": [
        "normal",
        "focused",
        "urgent",
        "confirmation-required"
      ],
      "title": "Mode",
      "type": "string"
    },
    "provenance": {
      "const": "original-pattern-derived",
      "default": "original-pattern-derived",
      "title": "Provenance",
      "type": "string"
    },
    "provenance_note": {
      "minLength": 20,
      "title": "Provenance Note",
      "type": "string"
    },
    "scenario_id": {
      "pattern": "^dlg_[0-9]{3}$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "split": {
      "enum": [
        "development",
        "held-out"
      ],
      "title": "Split",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "turns": {
      "items": {
        "$ref": "#/$defs/DialogueTurn"
      },
      "minItems": 2,
      "title": "Turns",
      "type": "array"
    }
  },
  "required": [
    "scenario_id",
    "title",
    "split",
    "mode",
    "turns",
    "provenance_note"
  ],
  "title": "DialogueScenario",
  "type": "object"
}
