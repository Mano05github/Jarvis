{
  "$defs": {
    "PrivacyMode": {
      "enum": [
        "WATCHING",
        "PRIVATE",
        "SLEEPING"
      ],
      "title": "PrivacyMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "duration_ms": {
      "minimum": 0,
      "title": "Duration Ms",
      "type": "integer"
    },
    "ended_monotonic_ns": {
      "minimum": 0,
      "title": "Ended Monotonic Ns",
      "type": "integer"
    },
    "privacy_mode": {
      "$ref": "#/$defs/PrivacyMode"
    },
    "retained": {
      "default": false,
      "title": "Retained",
